WORKFLOW_OS_HOST=127.0.0.1
WORKFLOW_OS_PORT=4310
WORKFLOW_OS_DATA_DIR=.local

# Phase 2.1 Free-First mode. Never commit real key values.
# The live free certification still requires an explicit run opt-in because it consumes provider quota.
# WORKFLOW_OS_FREE_FIRST_RUN=yes
# WORKFLOW_OS_FREE_FIRST_DATA_DIR=.local/phase21-free-live

# Independent free API routes. Keep these in the local PowerShell process only.
# GROQ_API_KEY=
# WORKFLOW_OS_GROQ_FREE_PLAN_ACK=yes
# WORKFLOW_OS_GROQ_FREE_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=

# Phase 2 paid/metered live certification remains available but is NOT used by Free-First mode.
# WORKFLOW_OS_LIVE_APPROVE_SPEND=yes
# WORKFLOW_OS_LIVE_MAX_MINOR=100
# WORKFLOW_OS_LIVE_CURRENCY=USD
# WORKFLOW_OS_LIVE_DATA_DIR=.local/phase2-live

# Optional direct paid API routes for the separate Phase 2 live harness.
# WORKFLOW_OS_OPENAI_API_KEY=
# WORKFLOW_OS_OPENAI_MODEL=
# WORKFLOW_OS_OPENAI_ESTIMATE_MINOR=10
# WORKFLOW_OS_OPENAI_MAX_OUTPUT_TOKENS=800

# WORKFLOW_OS_ANTHROPIC_API_KEY=
# WORKFLOW_OS_ANTHROPIC_MODEL=
# WORKFLOW_OS_ANTHROPIC_ESTIMATE_MINOR=10
# WORKFLOW_OS_ANTHROPIC_MAX_TOKENS=800
