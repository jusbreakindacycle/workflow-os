{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-os.local/schemas/ai-employee-v0.schema.json",
  "title": "Workflow OS AI Employee Spec v0",
  "type": "object",
  "required": [
    "spec_version",
    "role",
    "purpose",
    "responsibilities",
    "non_responsibilities",
    "operating_model",
    "governance",
    "authority",
    "capabilities",
    "reasoning_policy",
    "context_policy",
    "delegation",
    "limits",
    "escalation",
    "evaluation",
    "observability"
  ],
  "properties": {
    "spec_version": { "const": "0.1" },
    "role": {
      "type": "object",
      "required": ["id", "display_name", "workspace_ref", "version", "environment", "human_owner_ref", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "workspace_ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["dev", "test", "prod"] },
        "human_owner_ref": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "test", "shadow", "supervised", "active", "paused", "retired"] }
      },
      "additionalProperties": false
    },
    "purpose": {
      "type": "object",
      "required": ["goal", "success_outcomes"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "success_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "non_responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "operating_model": {
      "type": "object",
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["request_driven", "event_driven", "scheduled", "batch", "background_monitored"] }
        }
      },
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "required": ["high_stakes_domains", "special_review_required"],
      "properties": {
        "high_stakes_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "employment",
              "credit_lending_insurance",
              "health_medical",
              "legal_compliance",
              "physical_safety_security",
              "significant_financial",
              "education_access",
              "government_benefits_enforcement",
              "other_high_stakes"
            ]
          }
        },
        "special_review_required": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "high_stakes_domains": { "minItems": 1 }
            },
            "required": ["high_stakes_domains"]
          },
          "then": {
            "properties": {
              "special_review_required": { "const": true }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": ["autonomy_class", "max_automatic_risk_tier", "r3_requires_human", "prohibited_actions", "identity_mode"],
      "properties": {
        "autonomy_class": { "enum": ["A0", "A1", "A2", "A3"] },
        "max_automatic_risk_tier": { "enum": ["R0", "R1", "R2"] },
        "r3_requires_human": { "const": true },
        "prohibited_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "identity_mode": { "enum": ["role_service_identity", "delegated_user_identity", "mixed_explicit"] }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": ["workflow_refs", "tool_refs", "knowledge_refs"],
      "properties": {
        "workflow_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skill_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tool_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "knowledge_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "reasoning_policy": {
      "type": "object",
      "required": ["instruction_ref", "model_policy_ref"],
      "properties": {
        "instruction_ref": { "type": "string", "minLength": 1 },
        "model_policy_ref": { "type": "string", "minLength": 1 },
        "agent_runtime_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "context_policy": {
      "type": "object",
      "required": ["data_classification", "cross_workspace_memory", "memory_write_mode"],
      "properties": {
        "data_classification": { "enum": ["Public", "Internal", "Confidential", "Restricted"] },
        "cross_workspace_memory": { "const": false },
        "memory_write_mode": { "enum": ["disabled", "approved_fields_only", "reviewed_summary", "policy_controlled"] },
        "retention_days": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "delegation": {
      "type": "object",
      "required": ["enabled", "allowed_role_refs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowed_role_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": { "properties": { "allowed_role_refs": { "maxItems": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["max_task_runtime_seconds", "max_reasoning_iterations", "max_tool_calls", "max_cost_usd", "max_delegation_depth", "max_concurrent_tasks"],
      "properties": {
        "max_task_runtime_seconds": { "type": "integer", "minimum": 1 },
        "max_reasoning_iterations": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "max_delegation_depth": { "type": "integer", "minimum": 0 },
        "max_concurrent_tasks": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "escalation": {
      "type": "object",
      "required": ["human_target_ref", "triggers", "timeout_action"],
      "properties": {
        "human_target_ref": { "type": "string", "minLength": 1 },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeout_action": { "enum": ["fail_closed", "pause", "reject", "manual_queue"] }
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": ["suite_refs", "promotion_requires_review"],
      "properties": {
        "suite_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "promotion_requires_review": { "const": true }
      },
      "additionalProperties": true
    },
    "observability": {
      "type": "object",
      "required": ["metrics"],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "delegation": {
            "properties": { "enabled": { "const": false } },
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "limits": {
            "properties": { "max_delegation_depth": { "const": 0 } }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
