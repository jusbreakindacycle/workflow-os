{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/workflow-os/wir-v0.schema.json",
  "title": "Workflow Intermediate Representation v0",
  "type": "object",
  "required": ["wir_version", "workflow"],
  "properties": {
    "wir_version": { "const": "0" },
    "workflow": {
      "type": "object",
      "required": ["id", "name", "workspace_ref", "project_ref", "version", "environment", "nodes", "edges", "policy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "workspace_ref": { "type": "string", "minLength": 1 },
        "project_ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "enum": ["development", "test", "staging", "production"] },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        },
        "policy": { "$ref": "#/$defs/policy" },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["trigger.manual", "trigger.webhook", "trigger.schedule", "action", "transform", "condition", "delay", "ai_transform", "human_approval", "end"]
        },
        "input_schema_ref": { "type": "string" },
        "output_schema_ref": { "type": "string" },
        "integration_ref": { "type": "string" },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "risk_tier": { "type": "string", "enum": ["R0", "R1", "R2", "R3"] },
        "config": { "type": "object", "additionalProperties": true },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "condition": { "type": "string" }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "max_runtime_ms": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "max_ai_iterations": { "type": "integer", "minimum": 0 },
        "requires_human_approval_for_r3": { "type": "boolean" },
        "data_classification": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
