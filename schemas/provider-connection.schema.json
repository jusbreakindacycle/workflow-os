{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autonomous-delivery:provider-connection:0.1",
  "title": "Provider Connection v0.1",
  "type": "object",
  "required": ["connection_version", "id", "provider", "connection_type", "billing_mode", "status", "credential_ref", "workspace_scope", "allowed_data_classes"],
  "properties": {
    "connection_version": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "connection_type": { "enum": ["api_key", "oauth", "subscription_cli", "local_service", "self_hosted", "other"] },
    "billing_mode": { "enum": ["zero_incremental", "included_subscription", "metered", "unknown"] },
    "status": { "enum": ["available", "degraded", "unavailable", "disabled"] },
    "credential_ref": { "type": ["string", "null"] },
    "workspace_scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "allowed_data_classes": { "type": "array", "items": { "enum": ["Public", "Internal", "Confidential", "Restricted"] }, "minItems": 1, "uniqueItems": true },
    "locality": { "enum": ["local", "remote", "hybrid"] },
    "execution_host_ref": { "type": ["string", "null"] },
    "privacy_notes_ref": { "type": ["string", "null"] },
    "quota_notes_ref": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
