{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autonomous-delivery:model-runtime-profile:0.1",
  "title": "Model or Runtime Capability Profile v0.1",
  "type": "object",
  "required": ["profile_version", "id", "kind", "provider", "capabilities", "locality", "cost_class", "status"],
  "properties": {
    "profile_version": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["model", "runtime", "combined_route"] },
    "provider": { "type": "string", "minLength": 1 },
    "provider_version": { "type": ["string", "null"] },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["level"],
        "properties": {
          "level": { "type": "integer", "minimum": 0, "maximum": 5 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "locality": { "enum": ["local", "remote", "hybrid"] },
    "cost_class": { "enum": ["zero", "variable_paid", "fixed_subscription", "unknown"] },
    "privacy": { "type": "object", "additionalProperties": true },
    "limits": { "type": "object", "additionalProperties": true },
    "status": { "enum": ["available", "degraded", "unavailable", "disabled"] },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
